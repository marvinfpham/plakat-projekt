{{ 'plakat-editorial.css' | asset_url | stylesheet_tag }}
<section class="plakat-editorial" aria-labelledby="PlakatTitle-{{ section.id }}">
  <div class="plakat-editorial__copy">
    <p class="plakat-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1 id="PlakatTitle-{{ section.id }}" class="plakat-editorial__title">{{ section.settings.heading | escape }}</h1>
    <p class="plakat-editorial__text">{{ section.settings.body | escape }}</p>
    {% if section.settings.button_link != blank and section.settings.button_label != blank %}
      <a class="plakat-editorial__link" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a>
    {% endif %}
  </div>
  <div class="plakat-editorial__visual">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '375, 550, 750, 1100, 1500', sizes: '(min-width: 750px) 50vw, 100vw', alt: section.settings.image.alt }}
    {% else %}
      <div class="plakat-editorial__placeholder" aria-label="Plads til godkendt originalt værk" role="img"><span>FORM<br>OG RO</span><small>01 / EN NY RETNING</small></div>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Plakat editorial",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PLAKATER MED PERSPEKTIV"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Rum til at se nærmere."},
    {"type": "textarea", "id": "body", "label": "Body", "default": "Originale plakater skabt med blik for form, sted og stemning. En ny samling er på vej."},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "Udforsk plakater"},
    {"type": "url", "id": "button_link", "label": "Button link"},
    {"type": "image_picker", "id": "image", "label": "Approved artwork image"}
  ],
  "presets": [{"name": "Plakat editorial"}]
}
{% endschema %}
